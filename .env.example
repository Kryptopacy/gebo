# ── 8004scan (AltLayer) ────────────────────────────────────────────────
EIGHT004SCAN_API_KEY=
EIGHT004SCAN_BASE_URL=https://8004scan.io/api/v1/public

# ── Chain ──────────────────────────────────────────────────────────────
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
CHAIN_ID=97

# ── Altana ─────────────────────────────────────────────────────────────
ALTANA_RELAY=https://relay.altana.network
ALTANA_KEYSTORE_56=0x6572427ED530BadcF7375Cf9A4709D8d2b0E7E0a
ALTANA_KEYSTORE_CONTROLLER_56=0x0834Ee2C9BdC3E3efF0a2dC34393D4B0e546A555

# ── Wallets — TESTNET ONLY. Never derive a mainnet key from these. ─────
DEV_PRIVATE_KEY=
DEMO_OWNER_PRIVATE_KEY=
REPUTATION_WRITER_PRIVATE_KEY=

# ── Database (Supabase) ────────────────────────────────────────────────
# Use the TRANSACTION-mode pooler on port 6543, NOT the direct 5432 connection.
# Transaction pooling has no prepared statements, hence prepare:false in src/db.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DB_POOL_MAX=5
