# Every variable the code actually reads, verified by a readiness gate that
# diffs this file against `process.env.*` references in app/, src/ and
# scripts/ - so an env var added in code but not documented here fails
# `npm run readiness` instead of being discovered in production (that is how
# X402_PAY_TO went missing once: the paid route fell back to the facilitator
# address and settlement became a self-transfer).

# ── Database (Supabase) ────────────────────────────────────────────────
# Use the TRANSACTION-mode pooler on port 6543, NOT the direct 5432 connection.
# Transaction pooling has no prepared statements, hence prepare:false in src/db.
DATABASE_URL=
DB_POOL_MAX=5

# ── Hosting / site identity ────────────────────────────────────────────
# Cron auth: cron routes REFUSE to run when unset. Long random string.
CRON_SECRET=
# Ops dashboard (/admin): login refuses when unset. Single admin, the email
# allowlist is fixed in src/lib/admin-auth.ts.
ADMIN_PASSWORD=
# Optional separate HMAC key for admin session cookies; falls back to
# CRON_SECRET so deployments need no extra secret.
ADMIN_SESSION_SECRET=
# Canonical public URL; OG images and the GEBO-operated disclosure use it.
NEXT_PUBLIC_SITE_URL=https://gebo-bsc.vercel.app
# Where x402 earnings are paid. MUST differ from the facilitator key's address
# or settlement is a self-transfer.
X402_PAY_TO=

# ── Chain ──────────────────────────────────────────────────────────────
BSC_MAINNET_RPC=https://bsc-rpc.publicnode.com
BSC_TESTNET_RPC=https://bsc-testnet-rpc.publicnode.com
# Comma-separated fallback RPC list for the registry reader (optional).
BSC_RPCS=

# ── 8004scan (AltLayer) — cross-reference only ─────────────────────────
EIGHT004SCAN_API_KEY=
EIGHT004SCAN_BASE_URL=https://8004scan.io/api/v1/public

# ── AI assistant (Gemini) ──────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Wallets — TESTNET ONLY. Never derive a mainnet key from these. ─────
# They end up in shell history, logs and screen recordings; treat as public.
# Roles are managed by scripts/gen-keys.ts, which fills only empty slots.
DEV_PRIVATE_KEY=
DEMO_OWNER_PRIVATE_KEY=
REPUTATION_WRITER_PRIVATE_KEY=

# ── Tuning knobs (defaults shown; unset is fine) ───────────────────────
SYNC_MAX_NEW=5000            # max new identities per sync run
CRON_SYNC_MAX_NEW=400        # ditto, in the cron route
CRON_RESOLVE_SLICE=120       # registrations resolved per cron tick
CRON_MATERIALIZE_SLICE=200   # census rows materialized into agents per cron tick
CRON_PROBE_BATCH=45          # endpoints probed per cron tick
CRON_CLASSIFY_SLICE=2000     # agents classified per cron tick
PROBE_TIMEOUT_MS=8000
PROBE_CONCURRENCY=
PER_OPERATOR_CAP=60          # max agents probed per operator (disclosed in UI)
RESOLVE_CONCURRENCY=
HOST_GAP_MS=
SCAN_MAX_PER_MIN=400
AUDIT_LIMIT=
SAMPLE=120                   # cohort size for measurement studies

# ── Script overrides ───────────────────────────────────────────────────
GEBO_PROD_URL=https://gebo-bsc.vercel.app   # verify-prod.ts target
GEBO_SPIKE_CHAIN=                           # '56' forces mainnet in the Altana spike
BASE=                                       # x402-buy-health.ts target origin

# ── Reserved, no reader yet ────────────────────────────────────────────
# Documented for the day a browser Supabase client is added; nothing reads
# these today. (Platform-provided vars - VERCEL_*, NODE_ENV - need no entry.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
